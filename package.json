{
  "name": "tg-bot",
  "version": "1.0.0",
  "private": true,
  "description": "The bot created by WhitesLove and Baros",
  "main": "miniapp-entry.js",
  "type": "module",
  "scripts": {
    "run": "node miniapp-entry.js",
    "run:legacy": "node index.js",
    "test": "node --test",
    "models:check": "node scripts/models/checkModels.js",
    "art:build": "node scripts/blender/art.js",
    "items:check": "node scripts/items/check-art.js",
    "items:build": "python scripts/items/build-art.py",
    "ui-art:build": "python scripts/ui/build-painted-icons.py",
    "epic-art:build": "python scripts/items/build-epic-art.py && python scripts/items/build-art.py --source art-source/items/epic --prefix epic-"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lodash": "4.18.1",
    "mongoose": "9.9.4",
    "node-cron": "4.6.0",
    "node-telegram-bot-api": "2.1.0",
    "three": "0.170.0"
  }
}
