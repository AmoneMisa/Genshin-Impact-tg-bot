# Telegram bot (used by Docker; a local config.js takes precedence)
BOT_TOKEN=123456:your-bot-token
ADMIN_ID=123456789
# Optional: comma-separated trusted chat ids, seeded on the first Docker start
TRUSTED_CHATS=

MONGO_URL=mongodb://localhost:27017/genshin_bot

# Telegram Mini App
MINI_APP_ENABLED=true
MINI_APP_PORT=8080
MINI_APP_HOST=0.0.0.0
MINI_APP_URL=https://example.com
MINI_APP_SHORT_NAME=game

# FreeLLMAPI (OpenAI-compatible proxy)
FREE_LLM_API_BASE_URL=http://127.0.0.1:3001/v1
FREE_LLM_API_KEY=freellmapi-your-unified-key
FREE_LLM_MODEL=auto:fast
FREE_LLM_TIMEOUT_MS=6500

# Docker only
# MongoDB for the bot container (default: the bundled mongo service)
DOCKER_MONGO_URL=
# Cloudflare tunnel token for `docker compose --profile tunnel up`
TUNNEL_TOKEN=
