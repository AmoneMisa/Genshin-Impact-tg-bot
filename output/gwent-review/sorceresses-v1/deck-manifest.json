  "textMetrics": [
    {
      "id": "so-leader-head",
      "title": {
        "text": "Филиппа Эйльхарт: Глава Ложи",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Ложа выслушает каждого. Решать всё равно придётся нам.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-leader-spells",
      "title": {
        "text": "Филиппа Эйльхарт: Хозяйка заклинаний",
        "fontSize": 21,
        "lines": 2,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Тот, кто считает слова, обычно пропускает главное.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-leader-elements",
      "title": {
        "text": "Филиппа Эйльхарт: Повелительница стихий",
        "fontSize": 21,
        "lines": 2,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Буря не спрашивает разрешения. Я тоже.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-leader-illusion",
      "title": {
        "text": "Филиппа Эйльхарт: Мастер иллюзий",
        "fontSize": 21,
        "lines": 2,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Некоторым легче поверить зеркалу, чем собственным глазам.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-apprentice",
      "title": {
        "text": "Ученица Аретузы",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Искра погасла. На этот раз хотя бы стол уцелел.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-adept",
      "title": {
        "text": "Адептка Ложи",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Власть начинается с умения не показать, как трудно тебе далась.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-healer",
      "title": {
        "text": "Целительница",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Дыши. Всё остальное пока оставь мне.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-seer",
      "title": {
        "text": "Провидица",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Вода спокойна. Это ещё не значит, что спокойно будущее.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-war-mage",
      "title": {
        "text": "Боевой маг",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Гром услышат позже. Сейчас им достаточно света.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-illusionist",
      "title": {
        "text": "Иллюзионистка",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Ты уверен, что разговаривал именно со мной?",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-knight",
      "title": {
        "text": "Рыцарь Ложи",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Я дал слово женщине. Её титул к этому отношения не имеет.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-guard",
      "title": {
        "text": "Страж Ложи",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Совет ещё не окончен. Подождите с другой стороны двери.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-golem",
      "title": {
        "text": "Голем",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Он терпеливо ждёт приказа. Даже когда некому его отдать.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-elemental",
      "title": {
        "text": "Вызванный элементаль",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Камень помнит тишину. Ветер приносит другие вести.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-portal-keeper",
      "title": {
        "text": "Хранительница порталов",
        "fontSize": 21,
        "lines": 2,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Сначала скажи, куда идёшь. Потом решим, стоит ли возвращаться.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-margarita",
      "title": {
        "text": "Маргарита Лаукс-Антиль",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Школа нужна для того, чтобы однажды ученицы стали свободнее нас.",
        "fontSize": 17.75,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-sheala",
      "title": {
        "text": "Шеала де Тансарвиль",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Чужое одобрение ещё ни разу не сделало заклинание точнее.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-tissaia",
      "title": {
        "text": "Тиссая де Врис",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Порядок на столе — первое, что ты ещё можешь изменить.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "so-fireball",
      "title": {
        "text": "Огненный шар",
        "fontSize": 21,
        "lines": 1,
        "box": [
