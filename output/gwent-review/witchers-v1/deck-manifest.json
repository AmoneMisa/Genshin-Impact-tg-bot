    {
      "id": "wi-leader-teacher",
      "title": {
        "text": "Весемир: Наставник школ",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Ещё раз. Чудовище не станет ждать, пока ты вспомнишь.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "wi-leader-hunter",
      "title": {
        "text": "Весемир: Охотник на чудовищ",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Старый ведьмак знает: следы говорят раньше людей.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "wi-leader-keeper",
      "title": {
        "text": "Весемир: Хранитель Каэр Морхена",
        "fontSize": 21,
        "lines": 2,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Камни можно сложить заново. С людьми всё труднее.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
