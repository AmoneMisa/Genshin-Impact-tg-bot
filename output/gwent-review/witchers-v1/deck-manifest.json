      "title": {
        "text": "Весемир: Старый Волк",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Самое трудное — дождаться, пока они вернутся.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "wi-wolf-novice",
      "title": {
        "text": "Ученик школы Волка",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Меч тяжёлый? Привыкнешь. Если доживёшь.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
