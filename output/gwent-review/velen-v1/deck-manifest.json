        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "ve-militia",
      "title": {
        "text": "Ополчение Велена",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "У нас нет лат. Зато отступать больше некуда.",
