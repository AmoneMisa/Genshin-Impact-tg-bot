        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "ve-bog-witch",
      "title": {
        "text": "Болотная ведьма",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "В болоте всё найдётся, милый. Даже то, чего ты не терял.",
