      "id": "ve-leader-baron",
      "title": {
        "text": "Кровавый Барон: Хозяин Хмырёвки",
        "fontSize": 21,
        "lines": 2,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Крепкие стены не помогают, когда дом пуст.",
