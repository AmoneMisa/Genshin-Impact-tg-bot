      "title": {
        "text": "Калеб Менге: Судья",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Дверь закрыта. Теперь взвесим ваши слова.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
