    {
      "id": "ef-leader-flame",
      "title": {
        "text": "Калеб Менге: Хранитель огня",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Пламя видно издалека. Пусть помнят, где его берегут.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
