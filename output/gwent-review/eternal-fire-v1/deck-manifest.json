      "title": {
        "text": "Калеб Менге: Обличитель",
        "fontSize": 21,
        "lines": 1,
        "box": [
          10,
          451,
          290,
          48
        ]
      },
      "quote": {
        "text": "Кто-то в толпе уже понял, что речь идёт о нём.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
    {
      "id": "ef-templar",
      "title": {
        "text": "Храмовник",
        "fontSize": 21,
        "lines": 1,
        "box": [
          82,
          451,
          220,
          48
        ]
      },
      "quote": {
        "text": "Щит не спрашивает, кто стоит за ним. Я спрашиваю.",
        "fontSize": 18,
        "lines": 2,
        "box": [
          8,
          522,
          294,
          55
        ]
      }
    },
